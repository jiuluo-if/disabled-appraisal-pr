ASSESSMENT_PROVIDER=agnes
AGNES_API_KEY=replace-with-your-agnes-api-key
AGNES_BASE_URL=https://api.agnes-ai.cn/v1
PORT=3000

# Set both to model IDs available to your Agnes account.
AGNES_TEXT_MODEL=agnes-3.0-flash
AGNES_VISION_MODEL=agnes-3.0-flash
AGNES_TEMPERATURE=0
AGNES_JSON_MODE=schema
AGNES_MAX_TOKENS=10000

REQUEST_TIMEOUT_MS=180000
CACHE_TTL_MS=900000
CACHE_CAPACITY=200
ANALYSIS_RATE_LIMIT_WINDOW_MS=60000
ANALYSIS_RATE_LIMIT_MAX_REQUESTS=60
ANALYSIS_CONCURRENCY_PER_IP=4
ANALYSIS_CONCURRENCY_GLOBAL=16
ANALYSIS_BODY_CONCURRENCY_PER_IP=2
ANALYSIS_BODY_CONCURRENCY_GLOBAL=8
ANALYSIS_BODY_CONCURRENCY_THRESHOLD_BYTES=262144

# Local development only: loopback HTTP, no TLS certificate files required.
# Do not set this in production.
LOCAL_HTTP=false
HOST=127.0.0.1

# Relative paths resolve from the gemini directory when LOCAL_HTTP=false.
SSL_KEY_PATH=gemini.lintsing.net.key
SSL_CERT_PATH=gemini.lintsing.net.pem

# Alternative provider configuration (select explicitly):
# ASSESSMENT_PROVIDER=kimi
# KIMI_API_KEY=replace-with-your-moonshot-api-key
# KIMI_API_URL=https://api.moonshot.cn/v1/chat/completions
# KIMI_TEXT_MODEL=kimi-k2.6
# KIMI_VISION_MODEL=kimi-k2.6
# KIMI_THINKING=disabled
# KIMI_TEMPERATURE=0.6
# KIMI_JSON_MODE=schema
# KIMI_MAX_TOKENS=10000
